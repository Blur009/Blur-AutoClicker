# -- Dependencies --
node_modules/

# -- Build output --
dist/
dist-ssr/
src-tauri/target/
/gen/schemas
profile.json.gz

# -- Staged runtime deps (regenerated by scripts/prepare-windows-redist.ps1) --
# .gitkeep is tracked so the tauri build-script glob (resources/*) has a match
# on fresh CI checkouts; the real files are recreated at bundle time.
src-tauri/resources/*
!src-tauri/resources/.gitkeep

# -- Environment --
.env
.env.*
*.local

# -- Tauri --
.tauri
*.key
*.key.pub

# -- IDE --
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# -- OS files --
.DS_Store
Thumbs.db
Desktop.ini

# -- Logs --
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# -- Misc local --
.VSCodeCounter/
*.csv
.continue

# -- Local UI test harness --
test.html
src/test-main.tsx
src/TestBed.tsx
src/tauri-mock-setup.ts
vite.test.config.ts
.claude/settings.local.json
piolium/