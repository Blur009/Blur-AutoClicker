{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BlurAutoClicker",
  "version": "3.9.1",
  "identifier": "BlurAutoClicker",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm run vite",
    "beforeBuildCommand": "pnpm run frontend:build",
    "removeUnusedCommands": true
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "BlurAutoClicker",
        "visible": false,
        "width": 500,
        "height": 150,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "maximizable": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": []
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Blur009/Blur-AutoClicker/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIyREY0RTc2QTU4Qjc1N0UKUldSK2RZdWxkazdmSW1IQmI4ZVMwOTRzWnBiVENhMFNYMFRtN0V4R3N0Q2JXQUdqM2t4VnRnNUYK"
    },
    "bundle": {
      "active": true,
      "targets": "nsis",
      "createUpdaterArtifacts": true,
      "publisher": "Blur009",
      "copyright": "Copyright (c) Blur009",
      "category": "Utility",
      "shortDescription": "정확한 CPS 타이밍을 제공하는 설정 가능한 자동 클릭기입니다.",
      "longDescription": "전역 단축키, 선택형 오버레이, 고급 타이밍 기능을 제공하는 성능 중심 자동 클릭기입니다. GPLv3 라이선스를 따릅니다.",
      "homepage": "https://github.com/Blur009/Blur-AutoClicker",
      "icon": [
        "icons/icon-deactivated-dark.ico"
      ],
      "windows": {
        "webviewInstallMode": {
          "type": "embedBootstrapper",
          "silent": true
        },
        "nsis": {
          "compression": "zlib"
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon-deactivated-dark.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    }
  }
}
